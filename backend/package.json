{
  "name": "nas-photo-manager-backend",
  "version": "1.0.0",
  "description": "Backend service for NAS Photo Manager",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "build": "tsup src/server.ts --format esm --dts --clean --out-dir dist",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@my-photo/shared": "workspace:*",
    "@libsql/client": "^0.17.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.1",
    "drizzle-orm": "^0.45.2",
    "express": "^4.18.2",
    "pino": "^10.3.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "@types/uuid": "^9.0.0",
    "drizzle-kit": "^0.31.10",
    "ts-node-dev": "^2.0.0",
    "tsup": "^8.5.1",
    "tsx": "^4.22.4",
    "typescript": "^5.5.4"
  }
}