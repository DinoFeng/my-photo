{
  "name": "nas-photo-manager",
  "version": "1.0.0",
  "description": "NAS Photo Manager - A photo management application for NAS devices",
  "type": "module",
  "scripts": {
    "install:all": "pnpm install",
    "dev": "concurrently \"cd backend && pnpm dev\" \"cd frontend && pnpm dev\"",
    "dev:backend": "cd backend && pnpm dev",
    "dev:worker": "cd worker && pnpm dev",
    "dev:frontend": "cd frontend && pnpm dev",
    "build:backend": "cd backend && pnpm build",
    "build:worker": "cd worker && pnpm build",
    "build:frontend": "cd frontend && pnpm build",
    "build": "pnpm run build:backend && pnpm run build:worker && pnpm run build:frontend",
    "db:generate": "cd backend && pnpm db:generate",
    "db:push": "cd backend && pnpm db:push"
  },
  "keywords": [
    "photo",
    "manager",
    "nas"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}